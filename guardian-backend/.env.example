APP_NAME="Guardian Reinsurance"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration (MySQL recommended for production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=guardian_reinsurance_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

# Mail Configuration (SMTP for live email delivery)
MAIL_MAILER=smtp
MAIL_HOST=smtp.yourmailserver.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@guardianrebrokers.co.ug"
MAIL_FROM_NAME="Guardian Reinsurance System"

# Recipient Email for Inquiries, Claims, and Quotes
NOTIFICATION_RECIPIENT_EMAIL=info@guardianrebrokers.co.ug
NOTIFICATION_RECIPIENT_NAME="Guardian Reinsurance Desk"

# Frontend / CORS allowed origins if restricted
# SANCTUM_STATEFUL_DOMAINS=yourdomain.com,www.yourdomain.com
